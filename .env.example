# Existing GA4 web stream. Rotate API_SECRET before enabling the new relay:
# the former fallback secret was committed to Git history.
MEASUREMENT_ID=G-XXXXXXXXXX
API_SECRET=replace-with-a-new-measurement-protocol-secret

# Generate with: openssl rand -hex 32
ANALYTICS_HMAC_SECRET=replace-with-at-least-32-random-characters
# Comma-separated HMAC user IDs excluded from local storage and GA4 forwarding.
ANALYTICS_EXCLUDED_USER_ID_HASHES=

# Collector dashboard access. DASHBOARD_AUTH_SECRET is optional but recommended.
# Generate the secret with: openssl rand -hex 32
DASHBOARD_PASSWORD=replace-with-a-strong-dashboard-password
DASHBOARD_AUTH_SECRET=replace-with-a-random-cookie-signing-secret
DASHBOARD_SESSION_TTL_HOURS=12

# Keep the application private behind Nginx. Change only when intentionally
# exposing the Node listener to another host or container network.
SERVER_HOST=127.0.0.1
SERVER_PORT=1086

ANALYTICS_DB_PATH=./state/analytics-users.sqlite
ALLOWED_PLUGIN_IDS=1370606842652257742,1387823712562916211,1414925802794094447,1473659572195493091
ALLOWED_EVENT_NAMES=plugin_launch

GA4_DEBUG=false
GA4_DRY_RUN=false
GA4_TIMEOUT_MS=4000
IP_RATE_LIMIT_PER_MINUTE=6000
USER_RATE_LIMIT_PER_MINUTE=300
